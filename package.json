{
  "name": "@cellapp/cli",
  "version": "0.1.0",
  "description": "CellApp static application deployment CLI and Agent Skill",
  "type": "module",
  "license": "MIT",
  "publishConfig": {"access": "public", "registry": "https://registry.npmjs.org/"},
  "workspaces": ["packages/cli", "packages/shared"],
  "engines": {"node": ">=22.12.0"},
  "bin": {"cellapp": "dist/packages/cli/src/main.js", "ohmyapp": "dist/packages/cli/src/main.js"},
  "files": ["dist/packages", "skills/cellapp-deploy", "README.md", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "cli": "tsx packages/cli/src/main.ts",
    "check:boundary": "node scripts/check-boundary.mjs",
    "check:skill": "node scripts/check-skill.mjs",
    "check:package": "node scripts/check-package.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
